@model DCC_SystemUser

@using (Html.BeginForm())
{
    @Html.HiddenFor(model => model.K_SystemUser)
    @Html.HiddenFor(model => model.AccessLevel)

    <fieldset>
        <h2 class="fakeLegend">System user details</h2>
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group marginTop20">
                    @Html.LabelFor(model => model.LogonID, "Logon ID", new { @class="width220" })
                    @Html.TextBoxFor(model => model.LogonID, new { @class="form-control width200", @maxlength="40" })
                    @Html.ValidationMessageFor(model => model.LogonID)
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.SystemUserFirstName, "First name", new { @class="width220" })
                    @Html.TextBoxFor(model => model.SystemUserFirstName, new { @class="form-control width200", @maxlength="20" })
                    @Html.ValidationMessageFor(model => model.SystemUserFirstName)
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.SystemUserLastName, "Last name", new { @class="width220" })
                    @Html.TextBoxFor(model => model.SystemUserLastName, new { @class="form-control width200", @maxlength="20" })
                    @Html.ValidationMessageFor(model => model.SystemUserLastName)
                </div>
                <h3>Select roles:</h3>
                @foreach (var sr in Model.SystemRoles)
                {
                    string hiddenID="hid" + sr.ID;
                    <div class="form-group">
                        @Html.Label(sr.Role, new { @for=sr.ID, @id="lbl" + sr.ID, @class="width220" })
                        @Html.CheckBox(sr.ID, sr.IsChecked, new { @class="normalCheckbox", @id=sr.ID, @onclick="onCheckboxClick(this); return true;" })
                        <input type="hidden" id=@hiddenID name=@hiddenID value=@sr.IsChecked.ToString() />
                    </div>
				}
            </div>
        </div>
    </fieldset>

    <div class="text-center">
        <input class="btn btn-success" name="saveButton" type="submit" value="Save changes" data-ays-ignore="" true"" />
        <input class="btn btn-success" type="button" value="List of system users" onclick="location.href='@Url.Action("SystemUserGrid", "Admin")';" />
    </div>
}






<script type="text/javascript">


    function onLoad()
    {
    }


    // sync checkboxes with corresponding hidden fields that are read in the post event
    function onCheckboxClick(obj)
    {
        var id = obj.id;
        var checked = document.getElementById(id).checked;
        if (checked)
            document.getElementById("hid" + id).value = "True";
        else
            document.getElementById("hid" + id).value = "False";

        if (id == 'NOACCESS')
        {
            if (checked)
            {
                // if user checked NO ACCESS, uncheck all other checkboxes
                $("input[type='checkbox']").each(function()
                {
                    var cbid = $(this).attr('id');
                    //var cbname = $(this).attr('name');
                    //var cbvalue = $(this).attr('value');
                    //var cbischecked = $(this).is(":checked");
                    if (cbid != 'NOACCESS')
                    {
                        document.getElementById(cbid).checked = false;
                        document.getElementById("hid" + cbid).value = "False";
                    }
                });
            }
        }
        else
        {
            // if user checked a checkbox, uncheck NO ACCESS
            document.getElementById('NOACCESS').checked = false;
            document.getElementById('hidNOACCESS').value = "False";
        }
    }


</script>
