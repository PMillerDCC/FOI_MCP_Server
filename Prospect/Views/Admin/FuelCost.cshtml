@model ProspectBusinessLayer.FuelCost

@using (Html.BeginForm())
{
    @Html.HiddenFor(model => model.K_FuelCost)

    <fieldset>
        <h2 class="fakeLegend">Fuel Costs</h2>
        <div class="row marginTop10">
            <div class="col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.EffectiveFrom, "Effective From", new { @class = "width250" })
                    @Html.JQueryUI().DatepickerFor(model => model.EffectiveFrom, new { @id = "EffectiveFrom", @class = "form-control width120" }).DateFormat("dd MMM yyyy")
                    @Html.ValidationMessageFor(model => model.EffectiveFrom)
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.PriceString, "Price", new { @class = "width250" })
                    @Html.TextBoxFor(model => model.PriceString, new { @class = "width100", @maxlength = "10", @onkeydown = "return restrictInput(event)" })
                    @Html.ValidationMessageFor(model => model.PriceString)
                </div>
            </div>
        </div>
    </fieldset>

    <div class="text-center">
        <input class="btn btn-success" name="saveButton" type="submit" value="Save Changes" data-ays-ignore="" true"" />
        <input class="btn btn-success" type="button" value="Back" onclick="location.href='@Url.Action("FuelCostGrid", "Admin")';" />
    </div>

}

<script type="text/javascript">

    $(document).ready(function () {

        $("#EffectiveFrom").datepicker({ dateFormat: 'dd/mm/yy' });


        // OnLoad

        function onLoad() {
            //showOrHideDivs();
            return false;
        }

        // Validation

        function restrictInput(event) {
            // Get the key code of the pressed key
            var keyCode = event.which || event.keyCode;

            // Allow numbers (0-9), backspace (8), delete (46), and pound (£) symbol (optionally)
            if ((keyCode >= 48 && keyCode <= 57) || keyCode === 8 || keyCode === 46 || keyCode === 190 || String.fromCharCode(keyCode) === '£') {
                return true;
            }

            // Block all other key inputs
            return false;
        }

    });

</script>