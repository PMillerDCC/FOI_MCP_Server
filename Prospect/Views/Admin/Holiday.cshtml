        <h2 class="fakeLegend">Bank holiday and school term dates</h2>
        <div class="row marginTop10">
            <div class="col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.Year, "Year", new { @class = "width250" })
