    <div class="text-center">
        <input class="btn btn-success" name="saveButton" type="submit" value="Save Changes" data-ays-ignore="" true"" />
        <input class="btn btn-success" type="button" value="Back to Bank holidays and school term dates" onclick="location.href='@Url.Action("HolidayGrid", "Admin")';" />
    </div>

}




<script type="text/javascript">


    $(document).ready(function () {


        // Customise jquery datepickers

        $.datepicker.setDefaults(
            {
                inline: true,
                dateFormat: 'd M yy',
                dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                firstDay: 1,
                showOtherMonths: true,
                showAnimation: 'fadeIn',
                showButtonPanel: true,
                changeYear: true,
                changeMonth: true,
                //maxDate:'365', // no of days after today ('0'=today)
                yearRange: "-100:+10"
            });

        $(function () {
            $("#NewYear").datepicker();
        });
          

   

    });




    // OnLoad

    function onLoad() {
        showOrHideDivs();
        return false;
    }




</script>
