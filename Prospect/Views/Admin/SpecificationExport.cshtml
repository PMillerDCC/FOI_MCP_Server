@model ProspectBusinessLayer.SpecificationExport

@using (Html.BeginForm())
{
    <div class="form-group">
        @Html.LabelFor(model => model.StartContractReference, "Start Contract Reference")
        @Html.TextBoxFor(model => model.StartContractReference, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.StartContractReference)
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.EndContractReference, "End Contract Reference")
        @Html.TextBoxFor(model => model.EndContractReference, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.EndContractReference)
    </div>

    <button type="submit" class="btn btn-success">Export</button>
}