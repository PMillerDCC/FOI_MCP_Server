@model ProspectBusinessLayer.TenderSpecification

@using (Html.BeginForm())
{
	<input type="hidden" value="@Html.AttributeEncode(Model.K_TenderSpecification)" id="K_TenderSpecification" name="K_TenderSpecification" />
	<input type="hidden" value="@Html.AttributeEncode(Model.Q_Tender)" id="Q_Tender" name="Q_Tender" />


	<fieldset>
		<h2 class="fakeLegend">Parent specification details</h2>
		<div class="row">
			<div class="col-lg-12">
				<div class="form-group marginTop10">
					@Html.LabelFor(model => model.ParentContractReference, "Parent contract reference", new { @class="width250" })
					@Html.TextBoxFor(model => model.ParentContractReference, new { @class="form-control width200", @readonly="readonly" })
				</div>
				<div class="form-group marginBottom20">
					@Html.LabelFor(model => model.TenderReference, "Tender reference", new { @class="width250" })
					@Html.TextBoxFor(model => model.TenderReference, new { @class="form-control width200", @readonly="readonly" })
				</div>
			</div>
		</div>
	</fieldset>

	if(Model.IsNew)
	{
		<fieldset>
			<h2 class="fakeLegend">Child specification details</h2>
			<div class="row">
				<div class="col-lg-12">
					<div class="form-group marginTop10 marginBottom20">
						@Html.LabelFor(model => model.Q_Specification, "Child Specification", new { @class="width250" })
						@Html.DropDownListFor(model => model.Q_Specification, Model.ddlSpecification.ToList(), "Required field", new { @id="ddlSpecification", @class="form-control width380", @onclick="ddlClick(this);", @onchange="ddlClick(this);", @onkeyup="return true;", @onkeydown="return true;", required="required" })
						@Html.ValidationMessageFor(model => model.Q_Specification)
					</div>
				</div>
			</div>
		</fieldset>
	}

	else
	{
		@Html.HiddenFor(model => model.Q_Specification)

		<fieldset>
			<h2 class="fakeLegend">Child specification details</h2>
			<div class="row">
				<div class="col-lg-12">
					<div class="form-group marginTop10">
						@Html.LabelFor(model => model.ChildContractReference, "Child contract reference", new { @class="width250" })
						@Html.TextBoxFor(model => model.ChildContractReference, new { @class="form-control width200", @readonly="readonly" })
					</div>
					<div class="form-group">
						@Html.LabelFor(model => model.ServiceNo, "Service number", new { @class="width250" })
						@Html.TextBoxFor(model => model.ServiceNo, new { @class="form-control width200", @readonly="readonly" })
					</div>
					<div class="form-group">
						@Html.LabelFor(model => model.RouteText, "Route", new { @class="width250" })
						@Html.TextBoxFor(model => model.RouteText, new { @class="form-control width300", @readonly="readonly" })
					</div>
					<div class="form-group">
						@Html.LabelFor(model => model.ContractTypeDescription, "Contract type", new { @class="width250" })
						@Html.TextBoxFor(model => model.ContractTypeDescription, new { @class="form-control width200", @readonly="readonly" })
					</div>
					<div class="form-group marginBottom20">
						@Html.LabelFor(model => model.DatesText, "Contract dates", new { @class="width250" })
						@Html.TextBoxFor(model => model.DatesText, new { @class="form-control width200", @readonly="readonly" })
					</div>
				</div>
			</div>
		</fieldset>
	}

	<fieldset>
		<h2 class="fakeLegend">Does it conform</h2>
		<div class="row">
			<div class="col-lg-6">
				<div class="form-group marginTop10">
					@Html.Label("IsRouteConforming", "Are the route and timetable as specified", new { @class="width250" })
					<input id="dummyIsRouteConforming" type="checkbox" name="dummyIsRouteConforming" class="hide" onclick="checkboxClick(this);">
					<label for="dummyIsRouteConforming"></label>
					@Html.CheckBoxFor(model => model.IsRouteConforming, new { @id="cbIsRouteConforming", @class="hide" })
				</div>
				<div class="form-group">
					@Html.LabelFor(model => model.RouteNotes, "Route/timetable notes", new { @class="width250" })
					<div style="width: auto">
						@Html.TextAreaFor(model => model.RouteNotes, new { @id="taRouteNotes", @class="form-control width500", onblur="TextAreaOnBlur(this)", style="height:100px;", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
						<div id="divtaRouteNotes" class="textAreaMessage"></div>
					</div>
					@Html.ValidationMessageFor(model => model.RouteNotes)
				</div>
				<div class="form-group">
					@Html.Label("IsTicketConforming", "Are the ticket as specified", new { @class="width250" })
					<input id="dummyIsTicketConforming" type="checkbox" name="dummyIsTicketConforming" class="hide" onclick="checkboxClick(this);">
					<label for="dummyIsTicketConforming"></label>
					@Html.CheckBoxFor(model => model.IsTicketConforming, new { @id="cbIsTicketConforming", @class="hide" })
				</div>
				<div class="form-group">
					@Html.LabelFor(model => model.TicketNotes, "Ticket notes", new { @class="width250" })
					<div style="width: auto">
						@Html.TextAreaFor(model => model.TicketNotes, new { @id="taTicketNotes", @class="form-control width500", onblur="TextAreaOnBlur(this)", style="height:100px;", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
						<div id="divtaTicketNotes" class="textAreaMessage"></div>
					</div>
					@Html.ValidationMessageFor(model => model.TicketNotes)
				</div>
			</div>
			<div class="col-lg-6">
				<div class="form-group">
					@Html.Label("IsVehicleConforming", "Are the vehicle details as specified", new { @class="width250" })
					<input id="dummyIsVehicleConforming" type="checkbox" name="dummyIsVehicleConforming" class="hide" onclick="checkboxClick(this);">
					<label for="dummyIsVehicleConforming"></label>
					@Html.CheckBoxFor(model => model.IsVehicleConforming, new { @id="cbIsVehicleConforming", @class="hide" })
				</div>
				<div class="form-group">
					@Html.LabelFor(model => model.VehicleNotes, "Vehicle notes", new { @class="width250" })
					<div style="width: auto">
						@Html.TextAreaFor(model => model.VehicleNotes, new { @id="taVehicleNotes", @class="form-control width500", onblur="TextAreaOnBlur(this)", style="height:100px;", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
						<div id="divtaVehicleNotes" class="textAreaMessage"></div>
					</div>
					@Html.ValidationMessageFor(model => model.VehicleNotes)
				</div>
				<div class="form-group">
					@Html.LabelFor(model => model.Notes, "General notes", new { @class="width250" })
					<div style="width: auto">
						@Html.TextAreaFor(model => model.Notes, new { @id="taNotes", @class="form-control width500", onblur="TextAreaOnBlur(this)", style="height:100px;", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
						<div id="divtaNotes" class="textAreaMessage"></div>
					</div>
					@Html.ValidationMessageFor(model => model.Notes)
				</div>
			</div>
		</div>
	</fieldset>
	<div class="text-center marginBottom20">
		<input class="btn btn-success" name="saveButton" type="submit" value="Save changes" data-ays-ignore="" true"" />
		<input class="btn btn-success" type="button" value="Back to tender" onclick="location.href='@Url.Action("Tender", "Tender")';" />
	</div>
}




<script type="text/javascript">


	$(document).ready(function ()
	{
       
        // Customise jquery datepickers

        $.datepicker.setDefaults(
        {
            inline:true,
            dateFormat:'d M yy',
            dayNamesMin:['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            firstDay:1,
            showOtherMonths:true,
            showAnimation:'fadeIn',
            showButtonPanel:true,
            changeYear:true,
            changeMonth:true,
            //maxDate:'365', // no of days after today ('0'=today)
            yearRange:"-100:+2"
        });




        // Initialise dropdownlists

        $('select').each(function (index)
        {
            var $this=$(this);
            var id=$this.attr("id");
            var ddl1=document.getElementById(id), option, i;
            for (i=0; i < ddl1.length; i++)
            {
                option=ddl1[i];
                if (option.text.toLowerCase() == "-- not set --")
                {
                    option.disabled=true;// disable this line if you want to allow user to select "-- not set --"
                    option.style.color="grey";
                }
                else
                {
                    option.style.color="#2e6492";
                }
            }
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color="grey";
            else
                this.style.color="#2e6492";
        });

        $('select').on('change', function ()
        {
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color="grey";
            else
                this.style.color="#2e6492";
        });




        // Initialise Checkboxes

        $("input:checkbox").each(function ()
        {
            var $this=$(this);
            var id=$this.attr("id");
            if (id.indexOf('dummy') == 0)
            {
                this.checked=document.getElementById(id.replace('dummy', 'cb')).checked;
            }
        });

	});




	// OnLoad

	function onLoad()
	{
		return false;
	}




	// Set checkboxes

	function checkboxClick(element)
	{
		var id=element.id;
		var target=id.replace('dummy', 'cb');
		var remember=document.getElementById(id);
		document.getElementById(target).checked=(remember.checked);
		return false;
	}




	// Show character count while typing in a textarea

	function TextAreaOnKeyUp(ctrl, max)
	{
        var remaining = max - ctrl.value.length;
		$("#div" + ctrl.id).html(remaining + " characters remaining");
	}

	function TextAreaOnBlur(ctrl)
	{
		$("#div" + ctrl.id).html("");
	}


</script>
