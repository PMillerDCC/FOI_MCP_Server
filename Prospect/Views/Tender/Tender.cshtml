            <h2 class="fakeLegend">Specifications in the package</h2>
            <div class="row">
                <div class="col-lg-12">
                    <div class="form-group marginTop10">
                        @Html.Label("Parent_Hyperlink", "Parent contract reference", new { @class="width230" })
