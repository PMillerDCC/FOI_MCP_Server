						    </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child02_ServiceNo, "Specification 2 service number", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child02_ServiceNo, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child02_RouteDescription, "Specification 2 route description", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child02_RouteDescription, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                    }

                    @if(!string.IsNullOrWhiteSpace(Model.Child04_ServiceNo))
                    {
                        <div class="form-group marginTop15">
                            @Html.Label("Child04_Hyperlink", "Specification 4 contract reference", new { @class="width230" })
						    <div class="padTop3">
							    <a class="hyperlink" href=@Model.Child04_HyperLink target="_blank">@Model.Child04_ContractReference</a>
						    </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child04_ServiceNo, "Specification 4 service number", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child04_ServiceNo, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child04_RouteDescription, "Specification 4 route description", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child04_RouteDescription, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                    }

                    @if(!string.IsNullOrWhiteSpace(Model.Child06_ServiceNo))
                    {
                        <div class="form-group marginTop15">
