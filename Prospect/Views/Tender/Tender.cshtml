                        <div class="form-group">
                            @Html.LabelFor(model => model.Child08_ServiceNo, "Specification 8 service number", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child08_ServiceNo, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child08_RouteDescription, "Specification 8 route description", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child08_RouteDescription, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                    }

                    @if(!string.IsNullOrWhiteSpace(Model.Child10_ServiceNo))
                    {
                        <div class="form-group marginTop15">
                            @Html.Label("Child10_Hyperlink", "Specification 10 contract reference", new { @class="width230" })
						    <div class="padTop3">
							    <a class="hyperlink" href=@Model.Child10_HyperLink target="_blank">@Model.Child10_ContractReference</a>
						    </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child10_ServiceNo, "Specification 10 service number", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child10_ServiceNo, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Child10_RouteDescription, "Specification 10 route description", new { @class="width230" })
                            @Html.TextBoxFor(model => model.Child10_RouteDescription, new { @class="form-control width350", @readonly="readonly" })
                        </div>
                    }

                </div>
            </div>

        </fieldset>
    }

    else
    {
        @Html.HiddenFor(model => model.Q_Specification)
        @Html.HiddenFor(model => model.ContractReference)
        @Html.HiddenFor(model => model.IsPackage)
        @Html.HiddenFor(model => model.ExceptionalConditions)
        @Html.HiddenFor(model => model.VehicleCapacity)
        @Html.HiddenFor(model => model.VehicleElderlyAndDisabled)
        @Html.HiddenFor(model => model.VehicleDimensions)
        @Html.HiddenFor(model => model.ServiceDetails1)
        @Html.HiddenFor(model => model.AverageMilesPerDay)

        <fieldset>
            <h2 class="fakeLegend">Specification details</h2>
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group marginTop10">
                        @Html.Label("Parent_Hyperlink", "Contract reference", new { @class="width230" })
						<div class="padTop3">
							<a class="hyperlink" href=@Model.Parent_HyperLink target="_blank">@Model.ContractReference</a>
						</div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ContractTypeDescription, "Contract type", new { @class="width230" })
                        @Html.TextBoxFor(model => model.ContractTypeDescription, new { @class="form-control width350", @readonly="readonly" })
                    </div>
                    <div class="form-group marginBottom10">
                        @Html.LabelFor(model => model.DatesText, "Contract period", new { @class="width230" })
                        @Html.TextBoxFor(model => model.DatesText, new { @class="form-control width350", @readonly="readonly" })
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.SpecificationServiceNo, "Service number", new { @class = "width230" })
                        @Html.TextBoxFor(model => model.SpecificationServiceNo, new { @class = "form-control width350", @maxlength = "100", @readonly = "readonly" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.RouteText, "Route", new { @class = "width230" })
                        @Html.TextBoxFor(model => model.RouteText, new { @class = "form-control width300", @readonly = "readonly" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.IsFuelTermText, "Do special fuel terms apply?", new { @class = "width230" })
                        @Html.TextBoxFor(model => model.IsFuelTermText, new { @class = "form-control width350", @readonly = "readonly" })
                    </div>
                </div>
