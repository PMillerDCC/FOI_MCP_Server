    <fieldset>
        <h2 class="fakeLegend">Tender details</h2>
        <div class="row">
            <div class="col-lg-6">
                <div class="form-group marginTop10">
                    @Html.LabelFor(model => model.TenderReference, "Tender reference", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderReference, new { @class="form-control width150", @readonly="readonly" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Q_Contractor, "Operator", new { @class="width230" })
                    @Html.DropDownListFor(model => model.Q_Contractor, Model.ddlContractor.ToList(), "Required field", new { @id="ddlContractor", @class="form-control width350", @onclick="ddlClick(this);", @onchange="ddlClick(this);", @onkeyup="return true;", @onkeydown="return true;", required="required" })
                    @Html.ValidationMessageFor(model => model.Q_Contractor, null, new { @class="marginLeft230" })
                </div>
                <h3>Days of operation</h3>
                <div class="form-group">
                    @Html.LabelFor(model => model.CalculatedNoOfDaysOfOperationFirstYear, "Days of operation (first year)", new { @class="width230" })
                    @Html.TextBoxFor(model => model.CalculatedNoOfDaysOfOperationFirstYear, new { @class="form-control width100", @readonly="readonly" })
                    @Html.ValidationMessageFor(model => model.CalculatedNoOfDaysOfOperationFirstYear, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.CalculatedNoOfDaysOfOperationFullTerm, "Days of operation (full term)", new { @class="width230" })
                    @Html.TextBoxFor(model => model.CalculatedNoOfDaysOfOperationFullTerm, new { @class="form-control width100", @readonly="readonly" })
                    @Html.ValidationMessageFor(model => model.CalculatedNoOfDaysOfOperationFullTerm, null, new { @class="marginLeft230" })
                </div>
                <h3>Prices</h3>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderAverageMilesPerDay, "Average miles per day", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderAverageMilesPerDay, new { @id="tbTenderAverageMilesPerDay", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.TenderAverageMilesPerDay, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderRatePerMile, "Rate per mile", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderRatePerMile, new { @id="tbRatePerMile", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.TenderRatePerMile, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderFuelPriceElement, "Fuel related price element", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderFuelPriceElement, new { @id="tbFuelPriceElement", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.TenderFuelPriceElement, null, new { @class="marginLeft230" })
                </div>
                 <div class="form-group">
                    @Html.LabelFor(model => model.TenderPricePerDay, "Tender price per day", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderPricePerDay, new { @id="tbTenderPricePerDay", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.TenderPricePerDay, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderPricePerYear, "Tender price per year", new { @class="width230" })
                    @Html.TextBoxFor(model => model.TenderPricePerYear, new { @id="tbTenderPricePerYear", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.TenderPricePerYear, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.EstimatedAverageRevenuePerDay, "Estimated average revenue per day", new { @class="width230" })
                    @Html.TextBoxFor(model => model.EstimatedAverageRevenuePerDay, new { @id="tbEstimatedAverageRevenuePerDay", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.EstimatedAverageRevenuePerDay, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.EstimatedAverageRevenuePerYear, "Estimated average revenue peryear", new { @class="width230" })
                    @Html.TextBoxFor(model => model.EstimatedAverageRevenuePerYear, new { @id="tbEstimatedAverageRevenuePerYear", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.EstimatedAverageRevenuePerYear, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.AverageCostPerDay, "Average cost per day", new { @class="width230" })
                    @Html.TextBoxFor(model => model.AverageCostPerDay, new { @id="tbAverageCostPerDay", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.AverageCostPerDay, null, new { @class="marginLeft230" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.AverageCostPerYear, "Average cost per year", new { @class="width230" })
                    @Html.TextBoxFor(model => model.AverageCostPerYear, new { @id="tbAverageCostPerYear", @class="form-control width100" })
                    @Html.ValidationMessageFor(model => model.AverageCostPerYear, null, new { @class="marginLeft230" })
                </div>
            </div>
            <div class="col-lg-6">
                <h3 class="marginTop10">Vehicle details</h3>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderVehicleDetails, "Vehicle details", new { @class="width230 hide" })
                    <div style="width:auto">
                        @Html.TextAreaFor(model => model.TenderVehicleDetails, new { @id="TenderVehicleDetails", @class="form-control width580 height80", onblur="TextAreaOnBlur(this)", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
                        <div id="divVehicleDetails" class="marginLeft230 width580 alignRight"></div>
                    </div>
                    @Html.ValidationMessageFor(model => model.TenderVehicleDetails, null, new { @class="width230" })
                </div>
                <div class="form-group marginTop20">
                    @Html.Label("IsConforming", "Agreed by PPT to be conforming?", new { @class="width230" })
                    <input id="dummyIsConforming" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                    <label for="dummyIsConforming"></label>
                    @Html.CheckBoxFor(model => model.IsConforming, new { @id="cbIsConforming", @class="hide" })
                </div>
                <div class="form-group">
                    @Html.Label("IncludeInTenderAnalysis", "Include in tender analysis?", new { @class="width230" })
                    <input id="dummyIncludeInTenderAnalysis" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                    <label for="dummyIncludeInTenderAnalysis"></label>
                    @Html.CheckBoxFor(model => model.IncludeInTenderAnalysis, new { @id="cbIncludeInTenderAnalysis", @class="hide" })
                </div>
                <div class="form-group">
                    @Html.Label("IsTenderAccepted", "Is tender accepted?", new { @class = "width230" })
                    <input id="dummyIsTenderAccepted" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                    <label for="dummyIsTenderAccepted"></label>
                    @Html.CheckBoxFor(model => model.IsTenderAccepted, new { @id="cbIsTenderAccepted", @class="hide" })
                </div>
                <div class="form-group">
                    @Html.Label("AnyTenderQualifications", "Any qualifications to the tender?", new { @class="width230" })
                    <input id="dummyAnyTenderQualifications" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                    <label for="dummyAnyTenderQualifications"></label>
                    @Html.CheckBoxFor(model => model.AnyTenderQualifications, new { @id="cbAnyTenderQualifications", @class="hide" })
                </div>
                <br/>
                <h3>Qualification notes</h3>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderQualificationNotes, "Qualification notes", new { @class="width230 hide" })
                    <div style="width:auto">
                        @Html.TextAreaFor(model => model.TenderQualificationNotes, new { @id="TenderQualificationNotes", @class="form-control width580 height80", onblur="TextAreaOnBlur(this)", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
                        <div id="divTenderQualificationNotes" class="width580 alignRight"></div>
                    </div>
                    @Html.ValidationMessageFor(model => model.TenderQualificationNotes, null, new { @class="width230" })
                </div>
                <h3>General notes</h3>
                <div class="form-group">
                    @Html.LabelFor(model => model.TenderNotes, "General notes", new { @class="width230 hide" })
                    <div style="width:auto">
                        @Html.TextAreaFor(model => model.TenderNotes, new { @id="TenderNotes", @class="form-control width580 height80", onblur="TextAreaOnBlur(this)", @maxlength="500", @onkeyup="TextAreaOnKeyUp(this, 1000);", @onkeydown="return true;" })
                        <div id="divNotes" class="marginLeft230 width580 alignRight"></div>
                    </div>
                    @Html.ValidationMessageFor(model => model.TenderNotes, null, new { @class="width230" })
                </div>
            </div>
        </div>
    </fieldset>

    <div class="text-center marginBottom20">
        <input class="btn btn-success" name="saveButton" type="submit" value="Save changes" data-ays-ignore="" true"" />
    </div>
}




<script type="text/javascript">

    $(document).ready(function () {

        // Customise jquery datepickers

        $.datepicker.setDefaults(
            {
                inline: true,
                dateFormat: 'd M yy',
                dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                firstDay: 1,
                showOtherMonths: true,
                showAnimation: 'fadeIn',
                showButtonPanel: true,
                changeYear: true,
                changeMonth: true,
                //maxDate:'365', // no of days after today ('0'=today)
                yearRange: "-100:+2"
            });




        // Initialise dropdownlists

        $('select').each(function (index) {
            var $this = $(this);
            var id = $this.attr("id");
            var ddl1 = document.getElementById(id), option, i;
            for (i = 0; i < ddl1.length; i++) {
                option = ddl1[i];
                if (option.text.toLowerCase() == "-- not set --") {
                    option.disabled = true;// disable this line if you want to allow user to select "-- not set --"
                    option.style.color = "grey";
                }
                else {
                    option.style.color = "#2e6492";
                }
            }
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color = "grey";
            else
                this.style.color = "#2e6492";
        });

        $('select').on('change', function () {
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color = "grey";
            else
                this.style.color = "#2e6492";
        });




        // Initialise Checkboxes

        $("input:checkbox").each(function () {
            var $this = $(this);
            var id = $this.attr("id");
            if (id.indexOf('dummy') === 0) {
                var target = document.getElementById(id.replace('dummy', 'cb'));
                this.checked = target?.checked || false;
            }
        });



    });

    // OnLoad

    function onLoad() {
        return false;
    }

    // Set checkboxes

    function checkboxClick(element) {
        var id = element.id;
        var realId = id.replace('dummy', 'cb');           
        var real = document.getElementById(realId);      
        if (!real) return;

        real.checked = element.checked;                   
        real.value = element.checked ? 'true' : 'false';

        real.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Show character count while typing in a textarea

    function TextAreaOnKeyUp(ctrl, max) {
        var remaining = max - ctrl.value.length;
        $("#div" + ctrl.id).html(remaining + " characters remaining");
    }

    function TextAreaOnBlur(ctrl) {
        $("#div" + ctrl.id).html("");
    }

    function toNum(v) { var n = parseFloat(String(v || '').replace(/,/g, '')); return isNaN(n) ? 0 : n; }
    function r2(n) { return Math.round(n * 100) / 100; }

    function recalcYearFromDays() {
        // the readonly “Days of operation (first year)”
        var days = parseInt($('#CalculatedNoOfDaysOfOperationFirstYear').val(), 10) || 0;

        var perDay = toNum($('#tbTenderPricePerDay').val());
        var revDay = toNum($('#tbEstimatedAverageRevenuePerDay').val());
        var costDay = toNum($('#tbAverageCostPerDay').val());

        $('#tbTenderPricePerYear').val(r2(perDay * days));
        $('#tbEstimatedAverageRevenuePerYear').val(r2(revDay * days));
        $('#tbAverageCostPerYear').val(r2(costDay * days));
    }

    $(function () {
        // fire on edits to per-day inputs
        $('#tbTenderPricePerDay,#tbEstimatedAverageRevenuePerDay,#tbAverageCostPerDay')
            .on('input change blur', recalcYearFromDays);

        // if the days field can change via AJAX, catch it too
        $('#CalculatedNoOfDaysOfOperationFirstYear').on('change', recalcYearFromDays);

        // initial fill
        recalcYearFromDays();
    });

</script>
