@model ProspectBusinessLayer.ContractsPaymentsScheduleParameters
@using (Html.BeginForm())
{
    <fieldset>
        <h2 class="fakeLegend doNotPrint">Contract Payment Schedule</h2>
        <div class="row">
            <div class="col-lg-12 doNotPrint">
                <div class="form-group marginTop20">
                    @Html.LabelFor(model => model.StartDate, "Start date", new { @class = "width250" })
                    @Html.JQueryUI().DatepickerFor(model => model.StartDate, new { @id = "StartDate", @class = "form-control width120 ays-ignore" }).DateFormat("dd MMM yyyy")
                    @Html.ValidationMessageFor(model => model.StartDate)
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.EndDate, "End date", new { @class = "width250" })
                    @Html.JQueryUI().DatepickerFor(model => model.EndDate, new { @id = "EndDate", @class = "form-control width120 ays-ignore" }).DateFormat("dd MMM yyyy")
                    @Html.ValidationMessageFor(model => model.EndDate)
                </div>

                <div class="marginLeft80">
                    <div id="divCreateLink" style="display: none">
                        <input class="btn btn-success" name="displayButton" type="submit" value="Generate Report" data-ays-ignore="" true"" />
                    </div>
                </div>
            </div>
            <div class="col-lg-12 marginTop40">
                @if (@Model.RawHTML == null)
                {
                    <p class="green fontSize14 marginTop30">Select the required start and end dates for the Contracts Payment Schedule Report.</p>

                }
                else
                {
                    <h2>Contracts Payments Schedule for period: @Model.StartDateText to @Model.EndDateText</h2>
                    @Model.RawHTML
                    <div style="clear: both">
                        <input type="button" class="btn btn-success marginTop20 marginBottom10" value="Print" onclick="window.print(); return true;" />
                    </div>
                }
            </div>

        </div>
    </fieldset>
}





<script type="text/javascript">

    $(document).ready(function () {
        // Customise jquery datepickers

        $.datepicker.setDefaults(
            {
                inline: true,
                dateFormat: 'd M yy',
                dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                firstDay: 1,
                showOtherMonths: true,
                showAnimation: 'fadeIn',
                showButtonPanel: true,
                changeYear: true,
                changeMonth: true,
                maxDate: '0', // no of days after today ('0' = today)
                yearRange: "-14:+0"
            });

        $("#StartDate").datepicker(
            {
                
                beforeShow: function (element, datepicker) {
                    var endDate = $("#EndDate").datepicker('getDate');
                    if ((endDate != null) && (endDate != "")) {
                        $("#StartDate").datepicker("option", "maxDate", endDate);
                    }
                }
            });

        $("#EndDate").datepicker(
            {
                
                beforeShow: function (element, datepicker) {
                    var startDate = $("#StartDate").datepicker('getDate');
                    if ((startDate != null) && (startDate != "")) {
                        $("#EndDate").datepicker("option", "minDate", startDate);
                    }
                }
            });

        $("#StartDate").change(function () {
            var startDate = $("#StartDate").datepicker('getDate');
            var endDate = $("#EndDate").datepicker('getDate');
            if (((startDate != null) && (startDate != "")) && ((endDate != null) && (endDate != "")))
                document.getElementById("divCreateLink").style.display = 'inline';
            else
                document.getElementById("divCreateLink").style.display = 'none';
        });

        $("#EndDate").change(function () {
            var startDate = $("#StartDate").datepicker('getDate');
            var endDate = $("#EndDate").datepicker('getDate');
            if (((startDate != null) && (startDate != "")) && ((endDate != null) && (endDate != "")))
                document.getElementById("divCreateLink").style.display = 'inline';
            else
                document.getElementById("divCreateLink").style.display = 'none';
        });


    });

    function onLoad() {
        return false;
    }

</script>
