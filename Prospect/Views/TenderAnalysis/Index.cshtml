@model ProspectBusinessLayer.Business_Objects.TenderAnalysisGrid

<style>
    .spec-group-a td {
        background-color: #f4f8ff !important;
    }

    .spec-group-b td {
        background-color: #eef3e8 !important;
    }
</style>

<fieldset>
    <h2 class="fakeLegend doNotPrint">Tender Analysis</h2>
    <div class="row">
        <div class="col-lg-12 doNotPrint">
            @using (Html.BeginForm("Index", "TenderAnalysis", FormMethod.Get, new { @class = "marginBottom10" }))
            {
                <div class="d-flex marginBottom10 marginTop20 align-items-center">
                    <label for="specStart" class="marginRight10">Specification Start</label>
                    <input id="specStart" name="specStart" type="number"
                           class="form-control marginRight20 marginLeft20 width140"
                           value="@ViewBag.SpecStart" />

                    <label for="specEnd" class="marginRight10 marginLeft20">Specification End</label>
                    <input id="specEnd" name="specEnd" type="number"
                           class="form-control marginRight20 marginLeft20 width140"
                           value="@ViewBag.SpecEnd" />

                    <button type="submit" class="btn btn-primary marginTop10">Submit</button>
                </div>
            }

            @using (Html.BeginForm("AcceptTender", "TenderAnalysis", FormMethod.Post))
            {
                <input type="hidden" name="specStart" value="@ViewBag.SpecStart" />
                <input type="hidden" name="specEnd" value="@ViewBag.SpecEnd" />
                @Html.Raw(Model.RenderGrid())
            }

            <div style="clear: both">
                <input type="button"
                       class="btn btn-success marginTop20 marginBottom10"
                       value="Print"
                       onclick="window.open('@Url.Action("Print", "TenderAnalysis", new { specStart = ViewBag.SpecStart, specEnd = ViewBag.SpecEnd })', 'TenderAnalysisPrint', 'width=1000,height=700,scrollbars=yes,resizable=yes'); return false;" />
            </div>
        </div>
    </div>
</fieldset>
