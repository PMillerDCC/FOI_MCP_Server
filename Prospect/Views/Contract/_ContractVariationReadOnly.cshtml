@model ProspectBusinessLayer.ContractVariation

<fieldset>
    <h2 class="fakeLegend">Contract variation @Model.ContractVariationNoText</h2>

    <div class="row marginTop10">
        <div class="col-lg-4">
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationDateStartText, "Variation start date", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationDateStartText, new { @class = "form-control width100", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationServiceNo, "Service number", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationServiceNo, new { @class = "form-control width100", @readonly = "readonly" })
            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.FuelTerm, "Speacial Fuel Terms Apply", new { @class = "width250" })
                @Html.CheckBoxFor(model => model.FuelTerm, new { @class = "form-control width200", @readonly = "readonly" })
            </div>*@
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationRouteStart, "Route start", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationRouteStart, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationRouteEnd, "Route end", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationRouteEnd, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationVehicleCapacity, "Vehicle capacity", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationVehicleCapacity, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationVehicleElderlyAndDisabled, "Accessibility", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationVehicleElderlyAndDisabled, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationVehicleDimensions, "Vehicle dimensions", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationVehicleDimensions, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationExceptionalConditions, "Exceptional conditions", new { @class = "width240" })
                @Html.TextBoxFor(model => model.ContractVariationExceptionalConditions, new { @class = "form-control width150", @readonly = "readonly" })
            </div>
        </div>
        <div class="col-lg-4">
            <h3 class="marginTop5">Days of operation</h3>
            <div class="form-group">
                @Html.Label("OperatesOnMon", "Monday", new { @class="width250" })
                <input id="dummyOperatesOnMon" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnMon"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnMon, new { @id="cbOperatesOnMon", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnTue", "Tuesday", new { @class="width250" })
                <input id="dummyOperatesOnTue" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnTue"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnTue, new { @id="cbOperatesOnTue", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnWed", "Wednesday", new { @class="width250" })
                <input id="dummyOperatesOnWed" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnWed"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnWed, new { @id="cbOperatesOnWed", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnThu", "Thursday", new { @class="width250" })
                <input id="dummyOperatesOnThu" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnThu"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnThu, new { @id="cbOperatesOnThu", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnFri", "Friday", new { @class="width250" })
                <input id="dummyOperatesOnFri" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnFri"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnFri, new { @id="cbOperatesOnFri", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnSat", "Saturday", new { @class="width250" })
                <input id="dummyOperatesOnSat" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnSat"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnSat, new { @id="cbOperatesOnSat", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnSun", "Sunday", new { @class="width250" })
                <input id="dummyOperatesOnSun" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnSun"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnSun, new { @id="cbOperatesOnSun", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnBankHolidays", "Bank Holidays", new { @class="width250" })
                <input id="dummyOperatesOnBankHolidays" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnBankHolidays"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnBankHolidays, new { @id="cbOperatesOnBankHolidays", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnSchoolDays", "School Days", new { @class="width250" })
                <input id="dummyOperatesOnSchoolDays" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnSchoolDays"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnSchoolDays, new { @id="cbOperatesOnSchoolDays", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnNonSchoolDays", "Non School Days", new { @class="width250" })
                <input id="dummyOperatesOnNonSchoolDays" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnNonSchoolDays"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnNonSchoolDays, new { @id="cbOperatesOnNonSchoolDays", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.Label("OperatesOnChristmasAndNewYear", "Mon-Fri between Christmas and New Year", new { @class="width250" })
                <input id="dummyOperatesOnChristmasAndNewYear" type="checkbox" name="checkbox" class="hide" onclick="checkboxClick(this);">
                <label for="dummyOperatesOnChristmasAndNewYear"></label>
                @Html.CheckBoxFor(model => model.ContractVariationOperatesOnChristmasAndNewYear, new { @id="cbOperatesOnChristmasAndNewYear", @class="hide", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationCalculatedNoOfDaysInOperation, "Calculated number of days of operation", new { @class="width250" })
                @Html.TextBoxFor(model => model.ContractVariationCalculatedNoOfDaysInOperation, new { @id="tbCalculatedNoOfDaysInOperation", @class="form-control width60", @readonly="readonly" })
            </div>
        </div>
        <div class="col-lg-4">
            <h3 class="marginTop5">Prices</h3>
            <div class="form-group">
                @Html.LabelFor(model => model.AgreementDescription, "Agreement for fares", new { @class="width240" })
                @Html.TextBoxFor(model => model.AgreementDescription, new { @class="form-control width150", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationAveragePricePerDay, "Contract price per day", new { @class="width240" })
                @Html.TextBoxFor(model => model.ContractVariationAveragePricePerDay, new { @class="form-control width100", @readonly="readonly" })
            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.ContractVariationAveragePricePerYear, "Contract price per year", new { @class="width240" })
                @Html.TextBoxFor(model => model.CvAveragePricePerYear, new { @class="form-control width100", @readonly="readonly" })
            </div>*@
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationAverageRevenuePerDay, "Estimate average revenue per day", new { @class="width240" })
                @Html.TextBoxFor(model => model.ContractVariationAverageRevenuePerDay, new { @class="form-control width100", @readonly="readonly" })
            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.CvAverageRevenuePerYear, "Estimate average revenue per year", new { @class="width240" })
                @Html.TextBoxFor(model => model.CvAverageRevenuePerYear, new { @class="form-control width100", @readonly="readonly" })
            </div>*@
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationAverageCostPerDay, "Contractor estimate of total income", new { @class="width240" })
                @Html.TextBoxFor(model => model.ContractVariationAverageCostPerDay, new { @class="form-control width100", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationRatePerMile, "Rate per mile", new { @class="width240" })
                @Html.TextBoxFor(model => model.ContractVariationRatePerMile, new { @class="form-control width100", @readonly="readonly" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ContractVariationAverageMilesPerDay, "Average miles per day", new { @class="width240" })
                @Html.TextBoxFor(model => model.ContractVariationAverageMilesPerDay, new { @class="form-control width100", @readonly="readonly" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
				@Html.Label("Ticket notes")
				<p class="fakeTextArea marginLeft240">@Model.ContractVariationTicketNotes</p>
            </div>
            @*<div class="form-group">
				@Html.Label("Service information")
				<p class="fakeTextArea marginLeft240">@Model.ContractVariationServiceInformation</p>
            </div>*@
            <div class="form-group">
				@Html.Label("Route/timetable notes")
				<p class="fakeTextArea marginLeft240">@Model.ContractVariationRouteTimetableNotes</p>
            </div>
            @*general notes??*@
        </div>
    </div>

</fieldset>
