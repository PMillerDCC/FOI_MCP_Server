@model ProspectBusinessLayer.ContractVariation

<fieldset>
    <h2 class="fakeLegend">Contract variation @Model.ContractVariationNoText</h2>
    <div class="text-right marginBottom10">
        <input class="btn btn-success hidden-print" type="button" value="Create word document" onclick="location.href='@Url.Action("ExportContractVariationToWord", "Contract", new { k_ContractVariation = Model.K_ContractVariation })';" />
    </div>
    <div class="row marginTop10">
        <div class="col-lg-4">
            <h3 class="marginTop1">Service details</h3>
                <div class="width400 floatLeft fontSize14">Reason for variation: <strong>@Model.ContractVariationReasonText</strong></div>
                <div class="width400 floatLeft fontSize14">Variation start date: <strong>@Model.ContractVariationVariationDateStartText</strong></div>
                <div class="width400 floatLeft fontSize14">Variation end date: <strong>@Model.ContractVariationVariationDateEndText</strong></div>
                <div class="width400 floatLeft fontSize14">Service number: <strong>@Model.PackageServiceNumbers</strong></div>
                <div class="width400 floatLeft fontSize14">Route: <strong>@Model.PackageRouteText</strong></div>
                <div class="width400 floatLeft fontSize14 marginBottom15">Exceptional conditions: <strong>@Model.ContractVariationExceptionalConditions</strong></div>

                <h3 class="marginTop1">Quality of service</h3>
                <div class="width400 floatLeft fontSize14">Vehicle capacity: <strong>@Model.ContractVariationVehicleCapacity</strong></div>
                <div class="width400 floatLeft fontSize14">Accessibility: <strong>@Model.ContractVariationVehicleElderlyAndDisabled</strong></div>
                <div class="width400 floatLeft fontSize14 marginBottom15">Vehicle dimensions: <strong>@Model.ContractVariationVehicleDimensions</strong></div>

                <h3 class="marginTop1">Agreement</h3>
                <div class="width400 floatLeft fontSize14 marginBottom10">Agreement for fares: <strong>@Model.AgreementDescription</strong></div>
            </div>
        <div class="col-lg-4">
            <h3 class="marginTop1">Days of operation</h3>
            <div class="width400 floatLeft fontSize14">Operates on Monday: <strong>@Model.ContractVariationOperatesOnMonText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Tuesday: <strong>@Model.ContractVariationOperatesOnTueText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Wednesday: <strong>@Model.ContractVariationOperatesOnWedText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Thursday: <strong>@Model.ContractVariationOperatesOnThuText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Friday: <strong>@Model.ContractVariationOperatesOnFriText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Saturday: <strong>@Model.ContractVariationOperatesOnSatText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on Sunday: <strong>@Model.ContractVariationOperatesOnSunText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on bank holidays: <strong>@Model.ContractVariationOperatesOnBankHolidaysText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on school days: <strong>@Model.ContractVariationOperatesOnSchoolDaysText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates on non school days: <strong>@Model.ContractVariationOperatesOnNonSchoolDaysText</strong></div>
            <div class="width400 floatLeft fontSize14">Operates between Christmas and New Year: <strong>@Model.ContractVariationOperatesOnChristmasAndNewYearText</strong></div>
            <div class="width400 floatLeft fontSize14">Days of operation (first year): <strong>@Model.ContractVariationCalculatedNoOfDaysOfOperationFirstYear</strong></div>
            <div class="width400 floatLeft fontSize14 marginBottom10">Days of operation (full term): <strong>@Model.ContractVariationCalculatedNoOfDaysOfOperationFullTerm</strong></div>
        </div>
        <div class="col-lg-4">
            <h3 class="marginTop1">Prices</h3>
            <div class="width400 floatLeft fontSize14">Average miles per day: <strong>@Model.ContractVariationAverageMilesPerDay.ToString("N1")</strong></div>
            <div class="width400 floatLeft fontSize14">Rate per mile: <strong>@Model.ContractVariationRatePerMile.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Fuel price element: <strong>@Model.ContractVariationFuelPriceElement.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Contract price per day: <strong>@Model.ContractVariationAveragePricePerDay.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Contract price per year: <strong>@Model.ContractVariationAveragePricePerYear.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Estimate of average revenue per day: <strong>@Model.ContractVariationAverageRevenuePerDay.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Estimate of average revenue per year: <strong>@Model.ContractVariationAverageRevenuePerYear.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14">Contractor estimate of total income per day: <strong>@Model.ContractVariationAverageCostPerDay.ToString("N2")</strong></div>
            <div class="width400 floatLeft fontSize14 marginBottom15">Contractor estimate of total income per year: <strong>@Model.ContractVariationAverageCostPerYear.ToString("N2")</strong></div>

            <h3>Notes</h3>
            <div class="width400 floatLeft fontSize14">@Model.ContractVariationNotes</div>
            <h3 class="marginTop1">Reason for edit</h3>
            <div class="width400 floatLeft fontSize14">@Model.ContractVariationReasonForEdit</div>
        </div>
    </div>
</fieldset>
