@model ProspectBusinessLayer.Tender

@{
    DateTime? nextVarStart = ViewBag.NextVariationStart as DateTime?;
    string nextVarStartText = nextVarStart.HasValue
        ? nextVarStart.Value.ToString("dd MMM yyyy")
        : "";

    bool editMode = (ViewBag.EditMode as bool?) ?? false;
    int editingVariationId = (ViewBag.EditingVariationId as int?) ?? -1;
}

@using (Html.BeginForm("Contract", "Contract", FormMethod.Post, new { id = "tenderForm" }))
{
    @Html.HiddenFor(m => m.K_Tender)
    @Html.HiddenFor(m => m.Q_Specification)
    @Html.HiddenFor(m => m.ContractReference)
    @Html.HiddenFor(m => m.IsPackage)
    @Html.HiddenFor(m => m.IsTenderAccepted)
    @Html.HiddenFor(m => m.RouteStart)
    @Html.HiddenFor(m => m.RouteEnd)
    @Html.HiddenFor(m => m.DateStart)
    @Html.HiddenFor(m => m.DateEnd)

    @Html.Hidden("NextVariationStart", nextVarStartText, new { id = "NextVariationStart" })
    @Html.Hidden("EditMode", editMode)
    @Html.Hidden("editingVariationId", editingVariationId)
    @Html.AntiForgeryToken()
    <fieldset>
        <h2 class="fakeLegend">@Model.TitleText details</h2>

        <div class="row">
            <div class="col-lg-6">
                <div class="form-group marginTop10">
                    @Html.Label("Parent_Hyperlink", "Contract reference", new { @class = "width210" })
                    <div class="padTop3">
                        <a class="hyperlink" href="@Model.Parent_HyperLink" target="_blank">@Model.ContractReference</a>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.TenderReference, "Tender reference", new { @class = "width210" })
                    @Html.TextBoxFor(m => m.TenderReference, new { @class = "form-control width300", @readonly = "readonly" })
                </div>

                <div class="form-group marginBottom10">
                    @Html.LabelFor(m => m.TenderClosingDate, "Tender closing date", new { @class = "width210" })
                    @Html.TextBoxFor(m => m.TenderClosingDateText, new { @class = "form-control width300", @readonly = "readonly" })
                </div>
            </div>

            <div class="col-lg-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.ContractorName, "Operator", new { @class = "width210" })
                    @Html.TextBoxFor(m => m.ContractorName, new { @class = "form-control width300", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.ContractorLicenceNo, "Licence number", new { @class = "width210" })
                    @Html.TextBoxFor(m => m.ContractorLicenceNo, new { @class = "form-control width300", @readonly = "readonly" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.ContractTypeDescription, "Contract type", new { @class = "width210" })
                    @Html.TextBoxFor(m => m.ContractTypeDescription, new { @class = "form-control width300", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </fieldset>

    <div class="marginTop20">
        <button id="btnNewContractVariation"
                type="button"
                class="paragraphButton"
                onclick="btnNewContractVariationClick(); return false;">
            Create new variation
        </button>

        <button type="button"
                class="paragraphButton"
                onclick="window.location='@Url.Action("Contract", "Contract", new { primaryKey = Model.K_Tender, editVariation = true })'">
            Edit Variation
        </button>
    </div>
}   <!-- END Tender form -->

@using (Html.BeginForm("Contract", "Contract", FormMethod.Post, new { id = "variationForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.K_Tender)
    @Html.Hidden("editingVariationId", editingVariationId)

    <div id="divNewContractVariation" style="display:@(editMode ? "block" : "none");">
        <fieldset>
            <h2 class="fakeLegend">
                @(editMode ? "Edit contract variation" : "New contract variation")
            </h2>

            <div class="row">
                <!-- LEFT COLUMN -->
                <div class="col-lg-4">
                    <h3 class="marginTop15">Variation details</h3>

                    <div class="form-group">
                        @Html.Label("ContractVariationIsCancelled", "Is cancelled?", new { @class = "width210" })
                        @Html.CheckBoxFor(m => m.ContractVariationIsCancelled, new { @id = "cbContractVariationIsCancelled" })
                    </div>

                    <div class="form-group">
                        @Html.Label("ContractVariationIsExtended", "Is extended?", new { @class = "width210" })
                        @Html.CheckBoxFor(m => m.ContractVariationIsExtended, new { @id = "cbContractVariationIsExtended" })
                    </div>

                    <div class="form-group">
                        @Html.Label("ContractVariationIsOther", "Other reason", new { @class = "width210" })
                        @Html.CheckBoxFor(m => m.ContractVariationIsOther, new { @id = "cbContractVariationIsOther" })
                    </div>

                    <div class="form-group" id="grpOtherReason" style="display:none;">
                        @Html.LabelFor(m => m.ContractVariationOtherReason, "Please specify", new { @class = "width210 hide" })
                        @Html.TextBoxFor(m => m.ContractVariationOtherReason, new { @id = "ContractVariationOtherReason", @class = "form-control width180", maxlength = "120" })
                        @Html.ValidationMessageFor(m => m.ContractVariationOtherReason, null, new { @class = "marginLeft210" })
                    </div>

                    <h3 class="marginTop40">Dates</h3>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationVariationDateStart, "Start date", new { @class = "width210" })
                        @Html.JQueryUI().DatepickerFor(m => m.ContractVariationVariationDateStart, new { @id = "ContractVariationVariationDateStart", @class = "form-control width100" }).DateFormat("dd MMM yyyy")
                        @Html.ValidationMessageFor(m => m.ContractVariationVariationDateStart, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationVariationDateEnd, "End date", new { @class = "width210" })
                        @Html.JQueryUI().DatepickerFor(m => m.ContractVariationVariationDateEnd, new { @id = "ContractVariationVariationDateEnd", @class = "form-control width100" }).DateFormat("dd MMM yyyy")
                        @Html.ValidationMessageFor(m => m.ContractVariationVariationDateEnd, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationServiceNo, "Service number", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationServiceNo, new { @class = "form-control width180", maxlength = "120" })
                        @Html.ValidationMessageFor(m => m.ContractVariationServiceNo, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationRouteStart, "Route start", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationRouteStart, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationRouteStart, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationRouteEnd, "Route end", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationRouteEnd, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationRouteEnd, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationExceptionalConditions, "Exceptional conditions", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationExceptionalConditions, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationExceptionalConditions, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ContractVariation_Q_Agreement, "Agreement for fares revenue", new { @class = "width250" })
                        @Html.DropDownList("ContractVariation_Q_Agreement", Model.ddlAgreement.ToList(), "- not set -", new { @class = "form-control width120" })
                        @Html.ValidationMessageFor(model => model.ContractVariation_Q_Agreement, null, new { @class = "marginLeft250" })
                    </div>

                    <h3>Quality of service</h3>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationVehicleCapacity, "Vehicle capacity", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationVehicleCapacity, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationVehicleCapacity, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationVehicleElderlyAndDisabled, "Accessibility", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationVehicleElderlyAndDisabled, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationVehicleElderlyAndDisabled, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationVehicleDimensions, "Vehicle dimensions", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationVehicleDimensions, new { @class = "form-control width180" })
                        @Html.ValidationMessageFor(m => m.ContractVariationVehicleDimensions, null, new { @class = "marginLeft210" })
                    </div>
                </div>

                <!-- MIDDLE COLUMN -->
                <div class="col-lg-3">
                    <h3 class="marginTop5">Days of operation</h3>

                    @foreach (var day in new[]
                    {
                        "Mon","Tue","Wed","Thu","Fri","Sat","Sun",
                        "BankHolidays","SchoolDays","NonSchoolDays","ChristmasAndNewYear"
                    })
                    {
                        var fieldName = "ContractVariationOperatesOn" + day;
                        var checkboxId = "cbContractVariationOperatesOn" + day;

                        <div class="form-group">
                            @Html.Label(fieldName, day, new { @class = "width210" })
                            @Html.CheckBox(fieldName, new { id = checkboxId })
                        </div>
                    }

                    <div class="form-group marginTop30">
                        @Html.LabelFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFirstYear, "Days of operation (first year)", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFirstYear, new { @id = "tbCalculatedNoOfDaysOfOperationFirstYear", @class = "form-control width50" })
                        @Html.ValidationMessageFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFirstYear, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFullTerm, "Days of operation (full term)", new { @class = "width210" })
                        @Html.TextBoxFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFullTerm, new { @id = "tbCalculatedNoOfDaysOfOperationFullTerm", @class = "form-control width50" })
                        @Html.ValidationMessageFor(m => m.ContractVariationCalculatedNoOfDaysOfOperationFullTerm, null, new { @class = "marginLeft210" })
                    </div>

                    <button type="button"
                            class="paragraphButton marginTop20"
                            onclick="calculateNoOfDaysOfOperation();">
                        Recalculate days of operation
                    </button>
                </div>

                <!-- RIGHT COLUMN -->
                <div class="col-lg-5">
                    <h3 class="marginTop5">Prices</h3>

                    @foreach (var field in new[]
                    {
                        new { Name = "ContractVariationAverageMilesPerDay", Label = "Average miles per day" },
                        new { Name = "ContractVariationRatePerMile", Label = "Rate per mile" },
                        new { Name = "ContractVariationFuelPriceElement", Label = "Fuel price element" },
                        new { Name = "ContractVariationAveragePricePerDay", Label = "Contract price per day" },
                        new { Name = "ContractVariationAveragePricePerYear", Label = "Contract price per year" },
                        new { Name = "ContractVariationAverageRevenuePerDay", Label = "Estimated average revenue per day" },
                        new { Name = "ContractVariationAverageRevenuePerYear", Label = "Estimated average revenue per year" },
                        new { Name = "ContractVariationAverageCostPerDay", Label = "Contractor estimate of total income per day" },
                        new { Name = "ContractVariationAverageCostPerYear", Label = "Contractor estimate of total income per year" }
                    })
                    {
                        <div class="form-group">
                            @Html.Label(field.Name, field.Label, new { @class = "width210" })
                            @Html.TextBox(field.Name, null, new { @class = "form-control width100 price-format" })
                        </div>
                    }

                    <h3 class="marginTop20">Notes</h3>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ContractVariationNotes, "Notes", new { @class = "width210 hide" })
                        <div style="width:auto;">
                            @Html.TextAreaFor(m => m.ContractVariationNotes, new { @id = "Notes", @class = "form-control width470 height160", maxlength = "500", onblur = "TextAreaOnBlur(this)", onkeyup = "TextAreaOnKeyUp(this, 1000);" })
                            <div id="divNotes" class="marginLeft470 width180 alignRight"></div>
                        </div>
                        @Html.ValidationMessageFor(m => m.ContractVariationNotes, null, new { @class = "marginLeft210" })
                    </div>

                    <div class="form-group">
                        <h3 class="marginTop20">Reason for edit</h3>
                        @Html.TextAreaFor(m => m.ContractVariationReasonForEdit, new { @class = "width380 height80"})
                    </div>

                </div>
            </div>
        </fieldset>

        <div class="text-center marginTop20">
            @if (editMode)
            {
                <input class="btn btn-warning"
                       type="submit"
                       name="editButton"
                       value="Save variation edit"
                       onclick="return confirm('Are you sure you want to update this variation?');" />

                <button type="button"
                        class="btn btn-default"
                        onclick="window.location='@Url.Action("Contract", "Contract", new { primaryKey = Model.K_Tender })'">
                    Cancel
                </button>
            }
            else
            {
                <input class="btn btn-success"
                       type="submit"
                       name="createButton"
                       value="Create new variation" />
            }
        </div>
    </div>
}

@if (Model.ContractVariationGrid != null && Model.ContractVariationGrid.Count > 0)
{
    foreach (var cv in Model.ContractVariationGrid.GridRows)
    {
        Html.RenderPartial("~/Views/Contract/_ContractVariationReadOnly.cshtml", cv);
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        $.datepicker.setDefaults({
            inline: true,
            dateFormat: 'd M yy',
            dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            firstDay: 1,
            showOtherMonths: true,
            showAnimation: 'fadeIn',
            showButtonPanel: true,
            changeYear: true,
            changeMonth: true,
            yearRange: "-100:+2"
        });

        $("#ContractVariationVariationDateStart").datepicker({
            inline: true,
            dateFormat: 'd M yy',
            changeYear: true,
            changeMonth: true,
            yearRange: "-100:+2",
            onClose: function (selectedDate) {
                $("#ContractVariationVariationDateEnd").datepicker("option", "minDate", selectedDate);
            }
        });

        $("#ContractVariationVariationDateEnd").datepicker({
            inline: true,
            dateFormat: 'd M yy',
            changeYear: true,
            changeMonth: true,
            yearRange: "-100:+2",
            onClose: function (selectedDate) {
                $("#ContractVariationVariationDateStart").datepicker("option", "maxDate", selectedDate);
            }
        });

        $('select').each(function () {
            var $this = $(this);
            var id = $this.attr("id");
            var ddl1 = document.getElementById(id), option, i;

            for (i = 0; i < ddl1.length; i++) {
                option = ddl1[i];
                if (option.text.toLowerCase() == "-- not set --") {
                    option.disabled = true;
                    option.style.color = "grey";
                }
                else {
                    option.style.color = "#2e6492";
                }
            }

            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color = "grey";
            else
                this.style.color = "#2e6492";
        });

        $('select').on('change', function () {
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color = "grey";
            else
                this.style.color = "#2e6492";
        });

        $("input:checkbox").each(function () {
            var $this = $(this);
            var id = $this.attr("id");
            if (id.indexOf('dummy') == 0) {
                this.checked = document.getElementById(id.replace('dummy', 'cb')).checked;
            }
        });
    });

    function onLoad() {
        return false;
    }

    function checkboxClick(element) {
        const exclusiveIds = [
            'dummyContractVariationIsCancelled',
            'dummyContractVariationIsExtended',
            'dummyContractVariationIsOther'
        ];

        if (exclusiveIds.includes(element.id)) {
            if (element.checked) {
                exclusiveIds.forEach(id => {
                    if (id !== element.id) {
                        const cb = document.getElementById(id);
                        if (cb && cb.checked) {
                            cb.checked = false;
                            checkboxClick(cb);
                        }
                    }
                });
            }
        }

        var targetId = element.id.replace('dummy', 'cb');
        var $target = $('#' + targetId);
        if ($target.length) {
            $target.prop('checked', element.checked).trigger('change');
        }
        return false;
    }

    function TextAreaOnKeyUp(ctrl, max) {
        var remaining = max - ctrl.value.length;
        $("#div" + ctrl.id).html(remaining + " characters remaining");
    }

    function TextAreaOnBlur(ctrl) {
        $("#div" + ctrl.id).html("");
    }

    function toggleOtherReason() {
        var cb = document.getElementById('cbContractVariationIsOther');
        var grp = document.getElementById('grpOtherReason');
        var ta = document.getElementById('ContractVariationOtherReason');
        if (!cb || !grp || !ta) return;

        if (cb.checked) {
            grp.style.display = '';
            ta.setAttribute('required', 'required');
            ta.disabled = false;
        } else {
            grp.style.display = 'none';
            ta.removeAttribute('required');
            ta.value = '';
            ta.disabled = false;
        }
    }

    $(function () {
        ['Cancelled', 'Extended', 'IsOther'].forEach(s => {
            var d = document.getElementById('dummyContractVariation' + s);
            var r = document.getElementById('cbContractVariation' + (s === 'IsOther' ? 'IsOther' : s));
            if (d && r) d.checked = r.checked;
        });

        toggleOtherReason();
        $('#cbContractVariationIsOther').on('change', toggleOtherReason);
    });

    function btnNewContractVariationClick() {
        if ($('#EditMode').val() === 'True') {
            return false;
        }

        var panel = document.getElementById('divNewContractVariation');
        var isHidden = (panel.style.display === 'none');
        panel.style.display = isHidden ? 'block' : 'none';

        if (!isHidden) return;

        var hidden = document.getElementById('NextVariationStart');
        var next = hidden ? hidden.value : '';

        var $start = $("#ContractVariationVariationDateStart");
        var $end = $("#ContractVariationVariationDateEnd");

        var contractStart = $('#DateStart').val() || '';
        var contractEnd = $('#DateEnd').val() || '';

        var fmt = $start.datepicker('option', 'dateFormat') || "d M yy";

        if (contractStart) {
            $start.datepicker('option', 'minDate', $.datepicker.parseDate(fmt, contractStart));
            $end.datepicker('option', 'minDate', $.datepicker.parseDate(fmt, contractStart));
        } else {
            $start.datepicker('option', 'minDate', null);
            $end.datepicker('option', 'minDate', null);
        }

        if (contractEnd) {
            $start.datepicker('option', 'maxDate', $.datepicker.parseDate(fmt, contractEnd));
            $end.datepicker('option', 'maxDate', $.datepicker.parseDate(fmt, contractEnd));
        } else {
            $start.datepicker('option', 'maxDate', null);
            $end.datepicker('option', 'maxDate', null);
        }

        if (next && !$start.val()) {
            var dt = $.datepicker.parseDate(fmt, next);
            $start.datepicker('setDate', dt);

            var endVal = $end.datepicker('getDate');
            if (endVal && endVal < dt) $end.val('');
        }
    }

    function recalcYearFromDays() {
        var days = parseInt($('#CalculatedNoOfDaysOfOperationFirstYear').val(), 10) || 0;

        var perDay = toNum($('#tbTenderPricePerDay').val());
        var revDay = toNum($('#tbEstimatedAverageRevenuePerDay').val());
        var costDay = toNum($('#tbAverageCostPerDay').val());

        $('#tbTenderPricePerYear').val(r2(perDay * days));
        $('#tbEstimatedAverageRevenuePerYear').val(r2(revDay * days));
        $('#tbAverageCostPerYear').val(r2(costDay * days));
    }

    function calculateNoOfDaysOfOperation() {
        var d1 = $("#ContractVariationVariationDateStart").datepicker('getDate');
        var d2 = $("#ContractVariationVariationDateEnd").datepicker('getDate');
        if (!d1 || !d2) {
            alert('Select both start and end dates.');
            return false;
        }

        const sch  = document.getElementById("cbContractVariationOperatesOnSchoolDays").checked;
        const nsch = document.getElementById("cbContractVariationOperatesOnNonSchoolDays").checked;
        if (!sch && !nsch) {
            alert('Select school days and/or non school days.');
            return false;
        }

        var startDay = d1.getDate();
        var startMonth = d1.getMonth() + 1;
        var startYear = d1.getFullYear();
        var endDay = d2.getDate();
        var endMonth = d2.getMonth() + 1;
        var endYear = d2.getFullYear();

        const fyCap = new Date(d1.getTime());
        fyCap.setDate(fyCap.getDate() + 364);
        const fyEnd = (d2 < fyCap) ? d2 : fyCap;

        let s =
            startDay.toString().padStart(2, "0") + '/' + startMonth.toString().padStart(2, "0") + '/' + startYear.toString() +
            endDay.toString().padStart(2, "0") + '/' + endMonth.toString().padStart(2, "0") + '/' + endYear.toString() +
            (document.getElementById("cbContractVariationOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax({
            cache: false,
            type: "GET",
            dataType: 'json',
            url: "/Specification/CalculateNoDaysOfOperation",
            data: { "dateAndDays": s },
            success: function (data) {
                document.getElementById("tbCalculatedNoOfDaysOfOperationFullTerm").value = data;
            },
            error: function () {
                alert('Failed to calculate number of days in operation.');
            }
        });

        let s2 =
            startDay.toString().padStart(2, "0") + '/' + startMonth.toString().padStart(2, "0") + '/' + startYear.toString() +
            fyEnd.getDate().toString().padStart(2, "0") + '/' + (fyEnd.getMonth() + 1).toString().padStart(2, "0") + '/' + fyEnd.getFullYear().toString() +
            (document.getElementById("cbContractVariationOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("cbContractVariationOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax({
            cache: false,
            type: "GET",
            dataType: 'json',
            url: "/Specification/CalculateNoDaysOfOperation",
            data: { "dateAndDays": s2 },
            success: function (data) {
                document.getElementById("tbCalculatedNoOfDaysOfOperationFirstYear").value = data;
            },
            error: function () {
                alert('Failed to calculate number of days in operation.');
            }
        });

        return false;
    }

    function formatPriceInput(input) {
        var num = input.value.replace(/,/g, '');
        if (!isNaN(num) && num.trim() !== '') {
            input.value = parseFloat(num).toLocaleString('en-GB', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }
    }

    $('input.price-format').on('blur', function () {
        formatPriceInput(this);
    });

    $(document).ready(function() {
        $('input.price-format').each(function() {
            formatPriceInput(this);
        });
    });

    $('#variationForm').on('submit', function () {
        $('input.price-format').each(function () {
            var val = $(this).val();
            if (val) {
                $(this).val(val.replace(/,/g, ''));
            }
        });
    });
</script>