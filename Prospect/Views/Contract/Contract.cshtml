<script type="text/javascript">

    $(document).ready(function ()
    {
        $('#myForm').submit(function (event)
        {
            event.preventDefault(); // Prevent the default form submission
            $.ajax(
            {
                type: 'POST',
                url: '@Url.Action("CalculateOperationalDaysAjax", "Contract")', // Adjust as needed
                data: $(this).serialize(), // Serialize the form data for submission
                success: function (response)
                {
                    console.log('Calculation Result:', response); // Log the entire response to the console
                    // For specific property logging, use response.PropertyName assuming response is JSON
                },
                error: function (xhr, status, error)
                {
                    console.log('Error:', error); // Log any error to the console
                }
            });
        });




        // Customise jquery datepickers

        $.datepicker.setDefaults(
        {
            inline: true,
            dateFormat: 'd M yy',
            dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
            firstDay: 1,
            showOtherMonths: true,
            showAnimation: 'fadeIn',
            showButtonPanel: true,
            changeYear: true,
            changeMonth: true,
            //maxDate:'365', // no of days after today ('0'=today)
            yearRange: "-100:+2"
        });

        $("#ContractVariationDateStart").datepicker(
        {
            dateFormat: "d M yy",
            onClose: function (selectedDate)
            {
                // When a date is selected on the start datepicker, update the minDate of the end datepicker
                $("#ContractVariationDateEnd").datepicker("option", "minDate", selectedDate);
            }
        });

        $("#ContractVariationDateEnd").datepicker(
        {
            dateFormat: "d M yy",
            onClose: function (selectedDate)
            {
                // When a date is selected on the end datepicker, update the maxDate of the start datepicker
                $("#ContractVariationDateStart").datepicker("option", "maxDate", selectedDate);
            }
        });

        $("#ContractVariationVariationDateStart").datepicker(
        {
            inline: true,
            dateFormat: 'd M yy',
            changeYear: true,
            changeMonth: true,
            yearRange: "-100:+2"
        });

        $("#ContractVariationVariationDateEnd").datepicker(
        {
            inline: true,
            dateFormat: 'd M yy',
            changeYear: true,
            changeMonth: true,
            yearRange: "-100:+2"
        });




        // Initialise dropdownlists

        $('select').each(function (index)
        {
            var $this=$(this);
            var id=$this.attr("id");
            var ddl1=document.getElementById(id), option, i;
            for (i=0; i < ddl1.length; i++) {
                option=ddl1[i];
                if (option.text.toLowerCase() == "-- not set --")
                {
                    option.disabled=true; // disable this line if you want to allow user to reset to "-- not set --"
                    option.style.color="grey";
                }
                else
                {
                    option.style.color="#2e6492";
                }
            }
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color="grey";
            else
                this.style.color="#2e6492";
        });

        $('select').on('change', function ()
        {
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color="grey";
            else
                this.style.color="#2e6492";
        });




        // Initialise Checkboxes

        $("input:checkbox").each(function ()
        {
            var $this=$(this);
            var id=$this.attr("id");
            if (id.indexOf('dummy') == 0)
            {
                this.checked=document.getElementById(id.replace('dummy', 'cb')).checked;
            }
        });



    });




    // OnLoad

    function onLoad()
    {
        return false;
    }




    // Set checkboxes

    function checkboxClick(element)
    {
        var id=element.id;
        var target=id.replace('dummy', 'cb');
        var remember=document.getElementById(id);
        document.getElementById(target).checked=(remember.checked);
        showOrHideDivs();
        return false;
    }




    // Show character count while typing in a textarea

    function TextAreaOnKeyUp(ctrl, max)
    {
        var remaining=max - ctrl.value.length;
        $("#div" + ctrl.id).html(remaining + " characters remaining");
    }

    function TextAreaOnBlur(ctrl)
    {
        $("#div" + ctrl.id).html("");
    }




    // New contract variation button

    function btnNewContractVariationClick()
    {
        var y=document.getElementById('divNewContractVariation');
        if (y.style.display === 'none')
            y.style.display='block';
        else
            y.style.display='none';
    }




    // Calculate days of operation

    function calculateNoOfDaysOfOperation()
    {
        var startDay=$("#ContractVariationDateStart").datepicker('getDate').getDate();
        var startMonth=$("#ContractVariationDateStart").datepicker('getDate').getMonth() + 1;
        var startYear=$("#ContractVariationDateStart").datepicker('getDate').getFullYear();
        var endDay=$("#ContractVariationDateEnd").datepicker('getDate').getDate();
        var endMonth=$("#ContractVariationDateEnd").datepicker('getDate').getMonth() + 1;
        var endYear=$("#ContractVariationDateEnd").datepicker('getDate').getFullYear();

        var startDate=$("#ContractVariationDateStart").datepicker('getDate');
        const futuredate=new Date(startDate);
        futuredate.setDate(futuredate.getDate() + 364);

        var endDay2=futuredate.getDate();
        var endMonth2=futuredate.getMonth() + 1;
        var endYear2=futuredate.getFullYear();

        let s =
            startDay.toString().padStart(2, "0") + '/' + startMonth.toString().padStart(2, "0") + '/' + startYear.toString() +
            endDay.toString().padStart(2, "0") + '/' + endMonth.toString().padStart(2, "0") + '/' + endYear.toString() +
            (document.getElementById("dummyContractVariationOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax(
            {
                cache: false,
                type: "GET",
                dataType: 'json',
                url: "/Specification/CalculateNoDaysOfOperation",
                data: { "dateAndDays": s },
                success: function (data)
                {
                    document.getElementById("tbCalculatedNoOfDaysOfOperationFullTerm").value=data;
                },
                error: function (xhr, ajaxOptions, thrownError)
                {
                    alert('Failed to calculate number of days in operation.');
                }
            });

        let s2 =
            startDay.toString().padStart(2, "0") + '/' + startMonth.toString().padStart(2, "0") + '/' + startYear.toString() +
            endDay2.toString().padStart(2, "0") + '/' + endMonth2.toString().padStart(2, "0") + '/' + endYear2.toString() +
            (document.getElementById("dummyContractVariationOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("dummyContractVariationOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax(
            {
                cache: false,
                type: "GET",
                dataType: 'json',
                url: "/Specification/CalculateNoDaysOfOperation",
                data: { "dateAndDays": s2 },
                success: function (data)
                {
                    document.getElementById("tbCalculatedNoOfDaysOfOperationFirstYear").value=data;
                },
                error: function (xhr, ajaxOptions, thrownError)
                {
                    alert('Failed to calculate number of days in operation.');
                }
            });

        return false;
    }



</script>
