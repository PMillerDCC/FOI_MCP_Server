                    @Html.CheckBoxFor(model => model.IsPackage, new { @id = "cbIsPackage", @class = "hide" })
                </div>
            </div>
        </div>
    </fieldset>

    <div id="divPackage" style="display:none;">

        <fieldset>
            <h2 class="fakeLegend">Specifications in the package</h2>
