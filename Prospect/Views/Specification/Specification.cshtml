<script type="text/javascript">


    $(document).ready(function ()
    {


        // Customise jquery datepickers

        $.datepicker.setDefaults(
            {
                inline: true,
                dateFormat: 'd M yy',
                dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                firstDay: 1,
                showOtherMonths: true,
                showAnimation: 'fadeIn',
                showButtonPanel: true,
                changeYear: true,
                changeMonth: true,
                //maxDate:'365', // no of days after today ('0'=today)
                yearRange: "-100:+2"
            });

        $("#DateStart").datepicker(
        {
            beforeShow: function (element, datepicker)
            {
                var dateEnd=$("#DateEnd").datepicker('getDate');
                if ((dateEnd != null) && (dateEnd != ""))
                {
                    $("#DateStart").datepicker("option", "maxDate", dateEnd);
                }
            }
        });

        $("#DateEnd").datepicker(
        {
            beforeShow: function (element, datepicker)
            {
                var dateStart=$("#DateStart").datepicker('getDate');
                if ((dateStart != null) && (dateStart != ""))
                {
                    $("#DateEnd").datepicker("option", "minDate", dateStart);
                }
            }
        });

        $("#TenderClosingDate").datepicker({ dateFormat: 'dd/mm/yy' });




        // Initialise dropdownlists

        $('select').each(function (index)
        {
            var $this=$(this);
            var id=$this.attr("id");
            var ddl1=document.getElementById(id), option, i;
            for (i=0; i < ddl1.length; i++)
            {
                option=ddl1[i];
                if (option.text.toLowerCase() == "-- not set --")
                {
                    option.disabled=true;// disable this line if you want to allow user to select "-- not set --"
                    option.style.color="grey";
                }
                else
                {
                    option.style.color="#2e6492";
                }
            }
            if ((this.value == "-- not set --") || (this.value == ""))
                this.style.color="grey";
            else
