<script type="text/javascript">
    // ---------- Helpers: checkbox sync & UI toggling ----------
    function syncDummyCheckboxes() {
        $("[id^='dummy']").each(function () {
            var real = document.getElementById(this.id.replace('dummy', 'cb'));
            if (real) this.checked = !!real.checked;
        });
    }

    function checkboxClick(element) {
        var targetId = element.id.replace('dummy', 'cb');
        var real = document.getElementById(targetId);
        if (real) real.checked = !!element.checked;
        showOrHideDivs();
        return false;
    }

    function showOrHideDivs() {
        var cbBlank = document.getElementById("cbIsBlank");
        var cbPkg = document.getElementById("cbIsPackage");
        var isBlank = !!(cbBlank && cbBlank.checked);
        var isPackage = !!(cbPkg && cbPkg.checked);

        var divPackage = document.getElementById("divPackage");
        var divAgreement = document.getElementById("divAgreement");
        var divNonPackage = document.getElementById("divNonPackage");
        var divTenderGrid = document.getElementById("divTenderGrid");

        if (divPackage) divPackage.style.display = (!isBlank && isPackage) ? 'inline' : 'none';
        if (divAgreement) divAgreement.style.display = !isBlank ? 'inline' : 'none';
        if (divNonPackage) divNonPackage.style.display = (!isBlank && !isPackage) ? 'inline' : 'none';
        if (divTenderGrid) divTenderGrid.style.display = !isBlank ? 'inline' : 'none';
    }

    window.ddlClick = window.ddlClick || function () { };

    // ---------- Textarea helpers ----------
    function TextAreaOnKeyUp(ctrl, max) {
        var remaining = max - ctrl.value.length;
        $("#div" + ctrl.id).html(remaining + " characters remaining");
    }

    function TextAreaOnBlur(ctrl) {
        $("#div" + ctrl.id).html("");
    }

    // ---------- Days of operation calculation ----------
    function calculateNoOfDaysOfOperation() {
        var $ds = $("#DateStart");
        var $de = $("#DateEnd");

        if (!$ds.length || !$de.length || !$ds.datepicker || !$de.datepicker) {
            alert('Date pickers are not ready.');
            return false;
        }

        var startDate = $ds.datepicker('getDate');
        var endDate = $de.datepicker('getDate');

        if (!startDate || !endDate) {
            alert('Please select both start and end dates.');
            return false;
        }

        var startDay = startDate.getDate();
        var startMonth = startDate.getMonth() + 1;
        var startYear = startDate.getFullYear();
        var endDay = endDate.getDate();
        var endMonth = endDate.getMonth() + 1;
        var endYear = endDate.getFullYear();

        var s =
            String(startDay).padStart(2, "0") + '/' + String(startMonth).padStart(2, "0") + '/' + String(startYear) +
            String(endDay).padStart(2, "0") + '/' + String(endMonth).padStart(2, "0") + '/' + String(endYear) +
            (document.getElementById("dummyOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax({
            cache: false,
            type: "GET",
            dataType: 'json',
            url: "/Specification/CalculateNoDaysOfOperation",
            data: { dateAndDays: s },
            success: function (data) {
                var tbFull = document.getElementById("tbCalculatedNoOfDaysOfOperationFullTerm");
                if (tbFull) tbFull.value = data;
            },
            error: function () {
                alert('Failed to calculate number of days in operation.');
            }
        });

        // First year: min(End, Start+364) inclusive window
        var capDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
        capDate.setDate(capDate.getDate() + 364);
        var firstYearEndDate = (endDate < capDate) ? endDate : capDate;

        var endDay2 = firstYearEndDate.getDate();
        var endMonth2 = firstYearEndDate.getMonth() + 1;
        var endYear2 = firstYearEndDate.getFullYear();

        var s2 =
            String(startDay).padStart(2, "0") + '/' + String(startMonth).padStart(2, "0") + '/' + String(startYear) +
            String(endDay2).padStart(2, "0") + '/' + String(endMonth2).padStart(2, "0") + '/' + String(endYear2) +
            (document.getElementById("dummyOperatesOnMon").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnTue").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnWed").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnThu").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnFri").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSat").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSun").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnNonSchoolDays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnBankHolidays").checked ? "y" : "f") +
            (document.getElementById("dummyOperatesOnChristmasAndNewYear").checked ? "y" : "f");

        $.ajax({
            cache: false,
            type: "GET",
            dataType: 'json',
            url: "/Specification/CalculateNoDaysOfOperation",
            data: { dateAndDays: s2 },
            success: function (data) {
                var tbFirst = document.getElementById("tbCalculatedNoOfDaysOfOperationFirstYear");
                if (tbFirst) tbFirst.value = data;
            },
            error: function () {
                alert('Failed to calculate number of days in operation.');
            }
        });

        return false;
    }

    // ---------- Package drop-down chaining ----------
    const maxSpecs = 10;

    function getSelectedSpecificationValues() {
        var selected = [];
        for (var i = 1; i <= maxSpecs; i++) {
            var $ddl = $("#ddlChild0" + i + "_Q_Specification");
            if ($ddl.length && $ddl.val()) selected.push($ddl.val());
        }
        return selected;
    }

    function populateDropdown(currentIndex) {
        var nextIndex = currentIndex + 1;
        if (nextIndex > maxSpecs) return;

        var $nextDiv = $("#divChild0" + nextIndex);
        var $nextDdl = $("#ddlChild0" + nextIndex + "_Q_Specification");
        var $baseDdl = $("#ddlChild01_Q_Specification");

        if (!$nextDdl.length || !$baseDdl.length) return;

        var selected = getSelectedSpecificationValues();

        $nextDdl.empty().append('<option value="" disabled selected>-- not set --</option>');

        $baseDdl.find("option").each(function () {
            var val = $(this).val();
            var text = $(this).text();
            if (!val) return;
            if (text.trim().toLowerCase() === "-- not set --") return;
            if (selected.indexOf(val) !== -1) return;
            $nextDdl.append($("<option>", { value: val, text: text }));
        });

        if ($nextDdl.children("option").length > 1) {
            $nextDiv.show();
        } else {
            $nextDiv.hide();
        }
    }

    $(document).ready(function () {
        // Early sync so UI reflects server state even if later code fails.
        try { syncDummyCheckboxes(); showOrHideDivs(); } catch (e) { console.error(e); }

        // Datepicker setup (guarded)
        try {
            if ($.datepicker) {
                $.datepicker.setDefaults({
                    dateFormat: 'd M yy',
                    dayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                    firstDay: 1,
                    showOtherMonths: true,
                    showAnimation: 'fadeIn',
                    showButtonPanel: true,
                    changeYear: true,
                    changeMonth: true,
                    yearRange: "c-100:c+50"
                });

                function syncDatePickers() {
                    var start = $("#DateStart").datepicker('getDate');
                    var end = $("#DateEnd").datepicker('getDate');
                    $("#DateStart").datepicker("option", "maxDate", end || null);
                    $("#DateEnd").datepicker("option", "minDate", start || null);
                }

                $("#DateStart").datepicker({ beforeShow: syncDatePickers });
                $("#DateEnd").datepicker({ beforeShow: syncDatePickers });
                $("#DateStart, #DateEnd").on("change", syncDatePickers);
                syncDatePickers();

                $("#TenderClosingDate").datepicker({ dateFormat: 'dd/mm/yy' });
            } else {
                console.warn('$.datepicker not found; skipping datepicker init.');
            }
        } catch (e) {
            console.error('Datepicker init failed:', e);
        }

        // Drop-down cosmetic init (guarded)
        try {
            $('select').each(function () {
                var ddl = this;
                for (var i = 0; i < ddl.length; i++) {
                    var option = ddl[i];
                    var text = (option.text || '').toLowerCase();
                    if (text === "-- not set --") {
                        option.disabled = true; // keep disabled per your original code
                        option.style.color = "grey";
                    } else {
                        option.style.color = "#2e6492";
                    }
                }
                ddl.style.color = ((ddl.value === "-- not set --") || (ddl.value === "")) ? "grey" : "#2e6492";
            });

            $('select').on('change', function () {
                this.style.color = ((this.value === "-- not set --") || (this.value === "")) ? "grey" : "#2e6492";
            });
        } catch (e) {
            console.error('Select init failed:', e);
        }

        // Chain the package drop-downs
        for (var i = 1; i < maxSpecs; i++) {
            (function (ix) {
                $("#ddlChild0" + ix + "_Q_Specification").on("change", function () {
                    populateDropdown(ix);
                });
            })(i);
        }

        // Final sync once everything settles (also fixes BFCache restores)
        $(window).on('load pageshow', function () {
            try { syncDummyCheckboxes(); showOrHideDivs(); } catch (e) { }
        });

        // Hide stray datepicker container (as per your original)
        $(function () { $('#ui-datepicker-div').hide(); });
    });
</script>

