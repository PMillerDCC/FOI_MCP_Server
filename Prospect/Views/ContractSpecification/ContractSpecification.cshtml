@model ProspectBusinessLayer.ContractSpecification

@using (Html.BeginForm())
{
    <input type="hidden" value="@Html.AttributeEncode(Model.K_ContractSpecification)" id="K_ContractSpecification" name="K_ContractSpecification" />

    <fieldset>
        <h2 class="fakeLegend">Contract details</h2>
        <div class="row">
            <div class="col-lg-6">
                <div class="form-group marginTop10">
                    @Html.LabelFor(model => model.ContractReference, "Contract reference", new { @class="width250" })
                    @Html.TextBoxFor(model => model.ContractReference, new { @class="form-control width50", @readonly="readonly" })
                </div>
                <div class="form-group marginBottom10">
                    @Html.LabelFor(model => model.RouteStart, "Route start", new { @class="width250" })
                    @Html.TextBoxFor(model => model.RouteStart, new { @class="form-control width50", @readonly="readonly" })
                </div>
            </div>
        </div>
    </fieldset>
}
