@{
	Layout=null;
}

<!DOCTYPE html>

<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge;chrome=1" />
	<!-- http://forums.asp.net/t/1964604.aspx?Error+Microsoft+Visual+Studio+Express+2013+Web   post dated feb 13 2014 5:32AM   -->
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" type="text/css" href="~/Content/DCC.css" />
	<link rel="icon" href="~/Content/DCC_Images/favicon.ico" />
	<link href="./css/bootstrap.min.css" rel="stylesheet" type="text/css" />
	<link href="./css/bootstrap-responsive.min.css" rel="stylesheet">
	<title>@ViewBag.SoftwareIdentity:@ViewBag.PageTitle</title>
	@Styles.Render("~/Content/css")
	<meta name="description" content="The description of my page" />
</head>

<body id="body">

	<div id="container" class="container">

		@* --- Banner & Navigation --- *@
		<header id="header" class="hidden-print">
			<div id="pageTitleContainer"><div id="pageTitle">@ViewBag.ApplicationTitle</div></div>
		</header>

		<div class="main">

			@* --- Page Title --- *@
			<h1 class="hide">Maintenance page</h1>

			@* --- Main Body --- *@
			<fieldset>
				<div class="alignCentre centre">
					<img src="~/Content/DCC_Images/under maintenance.jpg" style="width:100%; max-width:900px; margin-top:-30px;" />
					<h2 class="marginTop30">We're sorry but @ViewBag.ApplicationTitle is currently down.</h2>
					<h2 class="marginTop10">Normal service is expected to resume @ViewBag.UnderMaintenance.</h2>
					<h2 class="marginTop10 marginBottom70">Thank you for your patience.</h2>
				</div>
			</fieldset>

		</div>

		@* --- Footer --- *@
		<footer id="footer" class="hidden-print">
			<div id="footerLeftMessage">@ViewBag.FooterMessage</div>
			<div id="footerRightMessage">Copyright &copy; @DateTime.Now.Year Durham County Council</div>
			<div style="clear:both"></div>
		</footer>

	</div>

	<script src="./Scripts/bootstrap.bundle.min.js"></script>
	<script src="~/Scripts/DCC.js"></script>

</body>

</html>
